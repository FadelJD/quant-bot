# kestrel environment variables. Names only; never commit values.
# Copy to .env (gitignored) or export in your shell / service unit.

# Alpaca paper account (equities and crypto). https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# CCXT sandbox / testnet (crypto). Exchange must expose a testnet: binance, bybit, okx.
KESTREL_CCXT_EXCHANGE=binance
KESTREL_CCXT_API_KEY=
KESTREL_CCXT_SECRET=

# Telegram bot (optional). Without a token the NullNotifier is used.
KESTREL_TELEGRAM_TOKEN=
KESTREL_TELEGRAM_CHAT_ID=

# Optional AI narrative (one of these; Anthropic is tried first).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional news headlines on the daily report.
KESTREL_NEWS_API_KEY=

# Display time zone for reports and Telegram (default Asia/Bangkok).
KESTREL_DISPLAY_TZ=Asia/Bangkok

# Set to 1 to run contract tests against real paper endpoints (never in CI).
KESTREL_INTEGRATION=
